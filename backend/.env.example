ENVIRONMENT=development
POSTGRES_DB=amp
DB_MIGRATION_USER=amp
DB_MIGRATION_PASSWORD=replace-with-a-url-safe-migration-password
DB_API_PASSWORD=replace-with-a-url-safe-api-password
DB_SCHEDULER_PASSWORD=replace-with-a-url-safe-scheduler-password
DB_EMAIL_WORKER_PASSWORD=replace-with-a-url-safe-email-worker-password
DB_YOUTUBE_WORKER_PASSWORD=replace-with-a-url-safe-youtube-worker-password
DB_CALCULATION_WORKER_PASSWORD=replace-with-a-url-safe-calculation-worker-password
DB_EXPORT_WORKER_PASSWORD=replace-with-a-url-safe-export-worker-password
DB_RETENTION_WORKER_PASSWORD=replace-with-a-url-safe-retention-worker-password
DB_LIFECYCLE_WORKER_PASSWORD=replace-with-a-url-safe-lifecycle-worker-password
# Used by the API when it runs directly on the host. Run Alembic with the
# schema-owner URL instead.
DATABASE_URL=postgresql+psycopg://amp_api:replace-with-a-url-safe-api-password@localhost:5432/amp
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=amp-content-factory
JWT_AUDIENCE=amp-content-factory-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
COOKIE_SECURE=false
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REDIS_URL=redis://localhost:6379/1
FRONTEND_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=no-reply@ampgroup.pro
YOUTUBE_API_KEY=replace-with-a-restricted-youtube-api-key
YOUTUBE_DAILY_WORKING_LIMIT=9000
YOUTUBE_REQUEST_TIMEOUT_SECONDS=15
SUSPICIOUS_MONTHLY_VIEW_GROWTH=500000
YOUTUBE_COLLECTION_HOUR_MOSCOW=23
SCHEDULER_POLL_INTERVAL_SECONDS=2
CALCULATION_CLOSE_DELAY_MINUTES=5
MINIO_ROOT_USER=amp-minio-root
MINIO_ROOT_PASSWORD=replace-with-a-long-minio-root-password
S3_API_ACCESS_KEY=amp-export-api
S3_API_SECRET_KEY=replace-with-a-long-api-s3-secret
S3_WORKER_ACCESS_KEY=amp-export-worker
S3_WORKER_SECRET_KEY=replace-with-a-long-worker-s3-secret
S3_ACCESS_KEY=amp-export-api
S3_SECRET_KEY=replace-with-a-long-api-s3-secret
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=private-exports
S3_FORCE_PATH_STYLE=true
EXPORT_ARTIFACT_TTL_HOURS=24
